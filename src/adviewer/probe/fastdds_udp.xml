<?xml version="1.0" encoding="UTF-8"?>
<!-- adviewer probe: Fast DDS over UDP only. Its default shared-memory transport fails across
     containers that do not share IPC, or between different users, and then no data arrives. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>adviewer_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="adviewer_probe" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>adviewer_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
