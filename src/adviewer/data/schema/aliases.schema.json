{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adviewer/data/aliases.schema.json",
  "title": "aliases.yaml: search words and sensor kits",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aliases"
  ],
  "properties": {
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sensor_kits": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
