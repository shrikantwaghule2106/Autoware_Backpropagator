{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adviewer/data/topic_params.schema.json",
  "title": "topic_params.yaml: parameters whose value is a topic name",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package",
          "param",
          "direction",
          "evidence"
        ],
        "properties": {
          "package": {
            "type": "string",
            "minLength": 1
          },
          "param": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "subscribe",
              "publish"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
