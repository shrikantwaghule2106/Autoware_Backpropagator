<launch>
  <arg name="common_param_path" default="/nonexistent.yaml"/>
  <arg name="speed" default="1.0"/>
  <node pkg="node_pkg" exec="planner" name="planner" namespace="planning">
    <param from="$(var common_param_path)"/>
    <param name="speed_limit" value="$(var speed)"/>
  </node>
</launch>
